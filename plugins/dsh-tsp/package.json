{
  "name": "dsh-tsp",
  "version": "0.1.0",
  "description": "Turn Summary Protocol for DeepSeek Harness.",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "^0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.2.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "^0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-agent": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.2.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
